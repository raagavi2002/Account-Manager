# Auto-detect text files and normalize line endings
* text=auto

# Ensure consistent line endings
*.cs      text diff=csharp
*.csproj text
*.sln     text eol=crlf
*.props   text
*.targets text
*.yml     text
*.yaml    text
*.json    text
*.md      text

# Shell scripts
*.sh      text eol=lf

# Docker files
Dockerfile text
*.dockerignore text

# Binary files (never diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
